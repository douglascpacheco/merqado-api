{
  "openapi": "3.0.0",
  "info": {
    "title": "MerQAdo API",
    "version": "1.0.0",
    "description": "API para controle de estoque de um mini mercado."
  },
  "paths": {
    "/usuarios": {
      "post": {
        "summary": "Cria um novo usuário",
        "description": "Cria um usuário com senha criptografada. O e-mail deve ser único.",
        "tags": ["Usuários"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string", "example": "Operador MerQAdo" },
                  "email": { "type": "string", "example": "operador@merqado.com" },
                  "senha": { "type": "string", "example": "123456" }
                },
                "required": ["nome", "email", "senha"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Usuário criado com sucesso." },
          "400": { "description": "Dados inválidos ou e-mail duplicado." }
        },
        "security": []
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Realiza login de um usuário",
        "description": "Retorna o token JWT para autenticação nas demais rotas.",
        "tags": ["Autenticação"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "operador@merqado.com" },
                  "senha": { "type": "string", "example": "123456" }
                },
                "required": ["email", "senha"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login realizado com sucesso." },
          "400": { "description": "Campos obrigatórios ausentes." },
          "401": { "description": "Credenciais inválidas." }
        },
        "security": []
      }
    },
    "/produtos": {
      "post": {
        "summary": "Cria um produto",
        "description": "Cria um produto ativo ou inativo para controle de estoque.",
        "tags": ["Produtos"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string", "example": "Arroz 5kg" },
                  "preco": { "type": "number", "example": 29.9 },
                  "quantidade": { "type": "integer", "example": 10 },
                  "estoque_minimo": { "type": "integer", "example": 3 },
                  "status": { "type": "string", "example": "ATIVO" }
                },
                "required": ["nome", "preco", "quantidade", "estoque_minimo"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Produto criado com sucesso." },
          "400": { "description": "Dados inválidos ou produto duplicado." },
          "401": { "description": "Não autenticado." }
        }
      },
      "get": {
        "summary": "Lista produtos",
        "tags": ["Produtos"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de produtos retornada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Produto" } }
                  }
                }
              }
            }
          },
          "401": { "description": "Não autenticado." }
        }
      }
    },
    "/produtos/{id}": {
      "get": {
        "summary": "Busca produto por ID",
        "tags": ["Produtos"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Produto encontrado.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Produto" } } } },
          "401": { "description": "Não autenticado." },
          "404": { "description": "Produto não encontrado." }
        }
      },
      "put": {
        "summary": "Atualiza produto",
        "tags": ["Produtos"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string" },
                  "preco": { "type": "number" },
                  "quantidade": { "type": "integer" },
                  "estoque_minimo": { "type": "integer" },
                  "status": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Produto atualizado com sucesso." },
          "400": { "description": "Dados inválidos ou produto duplicado." },
          "401": { "description": "Não autenticado." },
          "404": { "description": "Produto não encontrado." }
        }
      }
    },
    "/movimentacoes": {
      "post": {
        "summary": "Registra movimentação de estoque",
        "description": "Registra entrada ou saída e atualiza o estoque do produto.",
        "tags": ["Movimentações"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "produto_id": { "type": "string" },
                  "tipo": { "type": "string", "example": "ENTRADA" },
                  "quantidade": { "type": "integer", "example": 5 }
                },
                "required": ["produto_id", "tipo", "quantidade"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Movimentação registrada com sucesso." },
          "400": { "description": "Dados inválidos, produto inativo ou estoque insuficiente." },
          "401": { "description": "Não autenticado." },
          "404": { "description": "Produto não encontrado." }
        }
      },
      "get": {
        "summary": "Lista histórico de movimentações",
        "tags": ["Movimentações"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Histórico retornado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Movimentacao" } }
                  }
                }
              }
            }
          },
          "401": { "description": "Não autenticado." }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Usuario": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "nome": { "type": "string" },
          "email": { "type": "string" }
        }
      },
      "Produto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "nome": { "type": "string" },
          "preco": { "type": "number" },
          "quantidade": { "type": "integer" },
          "estoque_minimo": { "type": "integer" },
          "status": { "type": "string" }
        }
      },
      "Movimentacao": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "produto_id": { "type": "string" },
          "tipo": { "type": "string" },
          "quantidade": { "type": "integer" },
          "data": { "type": "string" }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
